# Warehouse Postgres connection (reuses hotelmind-data warehouse credentials)
WAREHOUSE_DB_HOST=localhost
WAREHOUSE_DB_PORT=5433
WAREHOUSE_DB_NAME=hotelmind_warehouse
WAREHOUSE_DB_USER=hotelmind_dw
WAREHOUSE_DB_PASSWORD=hotelmind_dw_secret

# ML-specific settings
CHURN_WINDOW_DAYS=180
FORECAST_HORIZON_DAYS=30
MODEL_DIR=models
REPORTS_DIR=reports
DATA_RAW_DIR=data/raw
LOG_LEVEL=INFO

# --- Phase 6: MLOps platform ---
# When running via `docker compose up -d`, these are overridden inside the
# containers to point at the `mlflow`/`mlflow-db` service names; these
# localhost defaults are for running the backend directly on the host while
# the compose stack's mlflow/mlflow-db containers are up (ports 5500/5544).
MLFLOW_TRACKING_URI=http://localhost:5500
MLFLOW_BACKEND_STORE_URI=postgresql://mlflow:mlflow@localhost:5544/mlflow
MLFLOW_ARTIFACT_ROOT=artifacts

MODEL_REGISTRY_DIR=models/registry
MODEL_STAGING_DIR=models/staging
MODEL_PRODUCTION_DIR=models/production
MODEL_ARCHIVED_DIR=models/archived

DRIFT_REPORTS_DIR=reports/drift
DATASET_VERSIONS_DIR=reports/dataset_versions
LOGS_DIR=logs

RETRAIN_ACCURACY_DROP_THRESHOLD=0.10
RETRAIN_DRIFT_SCORE_THRESHOLD=0.30

MLOPS_JSON_LOGGING=false
